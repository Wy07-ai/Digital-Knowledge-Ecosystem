{
  "name": "digital-knowledge-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "Alat build CSS untuk DKE. Hanya dibutuhkan bila Anda mengubah kelas Tailwind; menjalankan aplikasi cukup Python.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i app/static/css/tailwind.src.css -o app/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i app/static/css/tailwind.src.css -o app/static/css/tailwind.css --watch",
    "build:fonts": "node scripts/copy-fonts.js"
  },
  "devDependencies": {
    "@fontsource/inter": "5.1.1",
    "tailwindcss": "3.4.17"
  }
}
